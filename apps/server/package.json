{
  "name": "@jarvis/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "hash-password": "tsx scripts/hash-password.ts",
    "vapid:generate": "tsx scripts/generate-vapid-keys.ts",
    "probe:claude": "tsx scripts/claude-probe.ts",
    "wa:import": "tsx --env-file-if-exists=../../.env scripts/wa-import.ts",
    "bench:voice": "tsx scripts/voice-bench.ts"
  },
  "devDependencies": {
    "@jarvis/device-sim": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/luxon": "3.7.6",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "ws": "8.22.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@anthropic-ai/sdk": "1.6.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@fastify/websocket": "11.3.7",
    "@jarvis/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "baileys": "7.0.0-rc14",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.8",
    "luxon": "3.7.2",
    "pino": "10.4.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  }
