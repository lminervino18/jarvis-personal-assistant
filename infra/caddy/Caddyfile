{
	email {$ACME_EMAIL}
	skip_install_trust
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

{$JARVIS_DOMAIN} {
	@compressible not path /ws /ws/*
	encode @compressible zstd gzip

	reverse_proxy server:8080 {
		transport http {
			dial_timeout 5s
		}
	}

	header -Server

	log {
		output stdout
		format filter {
			fields {
				request>uri regexp \?.*$ ""
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
