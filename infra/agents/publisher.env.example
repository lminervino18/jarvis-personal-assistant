# Build publisher (systemd unit jarvis-publisher, runs as deploy). Copy to /etc/jarvis/publisher.env,
# owner root, group deploy, mode 640. It never holds Claude tokens or personal credentials.

# Same value as PUBLISH_SIGNING_KEY in the server's env file (openssl rand -hex 32).
PUBLISH_SIGNING_KEY=

PUBLISH_DIR=/srv/jarvis-publish
PUBLISH_FETCH_URL=https://github.com/OWNER/jarvis-personal-assistant.git
PUBLISH_PUSH_URL=git@github.com:OWNER/jarvis-personal-assistant.git

# Deploy key with write access to this repository only, and GitHub's verified host keys.
PUBLISH_SSH_KEY=/home/deploy/.ssh/jarvis_publish
PUBLISH_KNOWN_HOSTS=/etc/jarvis/github_known_hosts

# Commits are authored as the owner.
PUBLISH_AUTHOR_NAME=
PUBLISH_AUTHOR_EMAIL=

JARVIS_DIR=/opt/jarvis
PUBLISH_CHECK_TIMEOUT_MINUTES=30
PUBLISH_DEPLOY_TIMEOUT_MINUTES=45
