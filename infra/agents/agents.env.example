# Agent runner (compose profile "agents"). Copy to /etc/jarvis/agents.env with mode 600.
# This file must hold only agent settings: no owner password, no personal tokens.

# Agents run on the owner's subscription. Generate a token for agents only with
# `claude setup-token` (separate from the chat's, so each one can be revoked alone).
# No API key is read. Keep paid extra usage disabled on the account.
AGENT_CLAUDE_CODE_OAUTH_TOKEN=

# Models: only Sonnet and Haiku are accepted. Opus or Fable make the runner refuse to start.
AGENT_MODEL_PLANNER=claude-sonnet-5-5
AGENT_MODEL_EXECUTOR=claude-sonnet-5-5
AGENT_MODEL_REVIEWER=claude-sonnet-5-5
AGENT_MODEL_SUBAGENT=claude-haiku-5-5

# Limits. There is no spending cap or plan reserve: agents wait for the reset when the plan runs out.
AGENT_CONCURRENCY=1
AGENT_MAX_FIX_ROUNDS=2
AGENT_MAX_ATTEMPTS=3
AGENT_RUN_TIMEOUT_MINUTES=30

# Owner's time zone, for the times written in notifications.
TIMEZONE=America/Argentina/Buenos_Aires

# Network for agent commands (comma-separated hosts, "*.example.com" wildcards). Unset means
# package registries and GitHub; set it empty for no network. Web research uses WebSearch and
# WebFetch, which do not depend on this list.
# AGENT_ALLOWED_DOMAINS=

# The sandbox is required in production. If it cannot start on the host, set AGENT_BASH=false
# to run agents with file tools only (they can edit, not execute) instead of disabling it.
# AGENT_BASH=false
