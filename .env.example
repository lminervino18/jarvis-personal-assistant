# J.A.R.V.IS configuration template. Never commit a filled copy.
# Local development: copy to .env and keep only the lines you set.
# Production (docs/deploy.md): "Compose" goes to /opt/jarvis/.env, "Backups (sidecar)" to
# /etc/jarvis/backup.env, everything else to /etc/jarvis/jarvis.env. Files mode 600.
# Lines left empty are passed as empty strings, so delete the ones you do not set.
# Wrap values containing "$" (OWNER_PASSWORD_HASH) in single quotes.

## Compose (deployment host only, read by docker compose for interpolation)
JARVIS_DOMAIN=
ACME_EMAIL=
JARVIS_TAG=
JARVIS_ENV_FILE=
JARVIS_BACKUP_ENV_FILE=
HTTP_PORT=
HTTPS_PORT=
# Build argument of the whisper image (small|medium|large-v3-turbo; default small).
WHISPER_MODEL=
# Days of encrypted history kept off-site; also what the assistant tells the owner about forgotten data.
BACKUP_RETENTION_DAYS=

## Server (NODE_ENV, HOST, PORT, DATA_DIR, WEB_DIST_DIR, ASSISTANT_DIR are set by the image)
NODE_ENV=
HOST=
PORT=
PUBLIC_ORIGIN=
DATA_DIR=
WEB_DIST_DIR=
ASSISTANT_DIR=
TIMEZONE=
OWNER_DISPLAY_NAME=
OWNER_PASSWORD_HASH=
SESSION_TTL_DAYS=
FOLLOW_UP_WINDOW_MS=
LOG_LEVEL=

## Claude runtime (never add ANTHROPIC_API_KEY; CLAUDE_CONFIG_DIR is set by the image)
RUNTIME=
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CONFIG_DIR=
# Defaults to claude-sonnet-5-5 when empty or unset.
CLAUDE_MODEL=
CLAUDE_EFFORT=
CLAUDE_MAX_TURNS=
CLAUDE_SESSION_MAX_TURNS=
CLAUDE_ALLOW_OVERAGE=

## Token encryption (base64, 32 bytes; required for Gmail and the WhatsApp bridge; keep a copy outside the server and outside backups)
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=

## Google OAuth (Gmail, read-only). GOOGLE_REDIRECT_URI defaults to <PUBLIC_ORIGIN>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

## Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

## YouTube
YOUTUBE_API_KEY=

## WhatsApp bridge (compose profile "whatsapp", one container only). Must be exactly true to enable it.
WHATSAPP_ENABLED=

## Reminders worker
REMINDER_GRACE_MINUTES=
WORKER_POLL_SECONDS=

## Voice. Providers: STT none|groq|openai|faster-whisper, TTS none|elevenlabs|piper.
## Compose profile "voice" runs piper and whisper on the private network: PIPER_URL=http://piper:5000, FASTER_WHISPER_URL=http://whisper:8000/v1
STT_PROVIDER=none
STT_MODEL=
STT_BASE_URL=
VOICE_LANGUAGE=es
GROQ_API_KEY=
OPENAI_API_KEY=
FASTER_WHISPER_URL=
TTS_PROVIDER=none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
ELEVENLABS_SAMPLE_RATE=24000
PIPER_URL=
PIPER_SAMPLE_RATE=22050
# Use 0 for a voice cloned from film audio.
VOICE_ROBOTIC_INTENSITY=0.15
# Comma-separated taint sources whose replies stay text-only. Empty: gmail_search,gmail_get_thread with elevenlabs, none with piper.
VOICE_TEXT_ONLY_SOURCES=

## Backups (sidecar). RESTIC_REPOSITORY example: s3:https://<endpoint>/<bucket>/jarvis
BACKUP_TIME=
BACKUP_HOST=
BACKUP_PING_URL=
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
